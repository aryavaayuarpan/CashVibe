# Copy to .env for Docker Compose. Keep .env private and out of source control.
# LOCAL: Leave DATABASE_URL blank to use the persistent named Docker volume.
# HOSTED: Set a Supabase PostgreSQL pooler URI, with URL-encoded password.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
DATABASE_URL=
# Keep false for local Docker SQLite. Hosted deployments MUST set true.
REQUIRE_POSTGRES=false
# Hosted: REQUIRE_POSTGRES=true
CASHVIBE_DB_PATH=data/cashvibe.db
CASHVIBE_CURRENCY=INR
CASHVIBE_TIMEZONE=Asia/Kolkata
CASHVIBE_SYNC_SECONDS=5

# Optional real language-model agent. Free-tier account/key needed.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional local model instead. Start the local-ai profile and pull its model.
# Docker Compose: OLLAMA_BASE_URL=http://ollama:11434
# Python outside Docker: OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b
